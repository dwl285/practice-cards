generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Artist {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  songs     Song[]
}

model Song {
  id        String         @id @default(cuid())
  title     String
  artistId  String?
  artist    Artist?        @relation(fields: [artistId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     PracticeItem[]

  @@unique([title, artistId])
}

model PracticeItem {
  id             String            @id @default(cuid())
  title          String
  referenceText  String
  practiceNotes  String?
  targetBpm      Int?
  archived       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  songId         String
  song           Song              @relation(fields: [songId], references: [id], onDelete: Cascade)
  checkpoints    TempoCheckpoint[]

  @@index([archived, updatedAt])
}

model TempoCheckpoint {
  id             String       @id @default(cuid())
  bpm            Int
  createdAt      DateTime     @default(now())
  practiceItemId String
  practiceItem   PracticeItem @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)

  @@index([practiceItemId, createdAt])
}
